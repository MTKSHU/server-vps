# ── Database / 数据库 ──────────────────────────────────────────────────────────
# 数据库名 / Database name
POSTGRES_DB=cluster
# 数据库用户名 / Database user
POSTGRES_USER=cluster
# 数据库密码，生产环境必须修改 / Database password — must be changed in production
POSTGRES_PASSWORD=change-this-postgres-password

# ── Authentication / 认证 ──────────────────────────────────────────────────────
# 初始管理员密码，首次启动后请立即在控制台修改
# Initial admin password — change it immediately after first login
ADMIN_INITIAL_PASSWORD=change-this-admin-password
# 登录会话有效期（小时）/ Login session lifetime in hours
SESSION_TTL_HOURS=168

# ── Network / 网络入口 ─────────────────────────────────────────────────────────
# 管理节点 Web/API 对外监听端口 / Management node Web/API listen port
HTTP_PORT=80
# 节点心跳超时（秒），超过此时间未收到心跳则标记为 offline
# Seconds without a heartbeat before a node is marked offline
NODE_STALE_AFTER_SECONDS=180
# 后端 CORS 允许来源，生产环境建议改为实际域名
# Backend CORS allowed origins — set to your actual domain in production
CORS_ALLOW_ORIGINS=*

# ── Port Routing / 端口路由 ────────────────────────────────────────────────────
# 管理节点对外暴露给用户的端口池（用于访问容器内部服务）
# Public port pool on the management node for user container service access
PORT_RANGE_START=20000
PORT_RANGE_END=39999
# 计算节点 Incus proxy 内部端口池（节点本地分配，不对外暴露）
# Internal Incus proxy port pool on compute nodes (local allocation, not public-facing)
NODE_PORT_RANGE_START=40000
NODE_PORT_RANGE_END=59999
# port-router 读取路由表的认证令牌，生产环境必须修改
# Token used by port-router to read the internal routing table — must be changed in production
PORT_ROUTER_TOKEN=change-this-port-router-token
# port-router 同步路由表的轮询间隔（秒）/ Route table sync interval in seconds
PORT_ROUTER_SYNC_INTERVAL=3

# ── Cross-node Data Sync / 跨节点数据同步 ─────────────────────────────────────
# 跨节点同步使用的 SSH 用户名 / SSH user for cross-node data sync
SYNC_SSH_USER=root
# SSH 端口 / SSH port
SYNC_SSH_PORT=22
# SSH 私钥路径，留空则使用系统默认密钥（~/.ssh/id_*）
# Path to SSH private key; leave empty to use the default system key (~/.ssh/id_*)
SYNC_SSH_IDENTITY_FILE=

# ── Agent / 节点代理 ───────────────────────────────────────────────────────────
# Agent 发布包允许的最大体积（MB）/ Maximum upload size for agent release files (MB)
AGENT_RELEASE_MAX_MB=100
# 宿主机上 agent 源码目录，后端通过 Docker 编译 agent 二进制时使用
# Host path to agent source; used by the backend to build agent binaries via Docker
AGENT_SOURCE_HOST_PATH=/opt/server-vps/agent

# ── HTTP Proxy / HTTP 代理 ─────────────────────────────────────────────────────
# HTTP/HTTPS 代理，用于 HuggingFace 模型下载等需要出口代理的场景（留空不使用）
# HTTP/HTTPS proxy for HuggingFace downloads and other outbound requests (leave empty to disable)
HTTPS_PROXY=
HTTP_PROXY=
# 不走代理的主机列表（逗号分隔）/ Comma-separated list of hosts that bypass the proxy
NO_PROXY=

# ── Resource Limits / 资源限制 ────────────────────────────────────────────────
# backend 容器最多使用的 CPU 核数（0 = 不限制）
# 管理节点与存储节点共用同一台机器时，建议设为机器总核数的一半（如 8 核机器设 4）
# 可防止模型下载/上传任务占满 CPU，导致管理界面响应变慢
# Maximum CPU cores for the backend container (0 = unlimited)
# When the management node runs on the same machine as the storage node,
# set to ~half the machine's total cores to prevent sync tasks from starving API responses
BACKEND_CPU_LIMIT=0
