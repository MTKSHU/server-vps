[Unit]
Description=GPU cluster node agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/cluster-node-agent.env
ExecStart=/usr/local/bin/cluster-node-agent --server ${CLUSTER_SERVER_URL} --token ${CLUSTER_NODE_TOKEN} --node-group ${CLUSTER_NODE_GROUP} --data-path ${CLUSTER_DATA_PATH} --interval 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
